# Copy to .env (already gitignored). Never commit your credentials.
# Create an OAuth Web Client in Google Cloud with authorized JS origin http://localhost:5175
GOOGLE_CLIENT_ID=

# SMTP: use a valid account authorized to send OTP, e.g. Gmail App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# DEVELOPMENT ONLY: false by default. true returns OTP to API response without SMTP.
# Never enable on a publicly reachable environment.
AUTH_ALLOW_DEV_CODE=false

# DEVELOPMENT ONLY. Fake .invalid accounts are seeded only when enabled.
# Choose a unique password of at least 16 characters; never commit your .env.
DEV_SEED_ENABLED=false
DEV_SEED_PASSWORD=
