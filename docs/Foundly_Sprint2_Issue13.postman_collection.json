{
  "info": {
    "name": "Foundly Sprint 2 Issue 13 - Contact & Directory API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login as visitor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"lan@campus.edu\", \"password\": \"Demo12345!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create contact",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/contacts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "contacts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"reportId\": \"{{reportId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===200 || pm.response.code===201){ pm.collectionVariables.set(\"contactId\",pm.response.json().id); }"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Send message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"contactId\": \"{{contactId}}\", \"content\": \"Xin chào, mình muốn hỏi thêm về đồ thất lạc.\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "My contacts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/contacts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "contacts"
          ]
        }
      }
    },
    {
      "name": "Message history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/messages?contactId={{contactId}}&page=1&pageSize=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "messages"
          ]
        }
      }
    },
    {
      "name": "Directory",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/directory",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "directory"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8081"
    },
    {
      "key": "reportId",
      "value": "REPLACE_WITH_OPEN_REPORT_UUID"
    },
    {
      "key": "contactId",
      "value": "REPLACE_AFTER_CREATE_CONTACT"
    }
  ]
}